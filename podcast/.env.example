ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
XAI_API_KEY=

# Defaults to a local offline provider so the foundation can run without paid APIs.
ACTIVE_LLM=dry-run
ACTIVE_MODEL=dry-run-v1

# Audio pipeline modes
INPUT_MODE=text
STT_MODE=deepgram
TTS_MODE=dry-run
DEEPGRAM_MODEL=nova-3
ELEVENLABS_MODEL=eleven_multilingual_v3
XAI_STT_LANGUAGE=en
XAI_TTS_VOICE=eve
XAI_TTS_LANGUAGE=en
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
CONFIRM_TRANSCRIPT=true
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=1
OPENAI_API_MODE=responses

ELEVENLABS_VOICE_ID=
AUDIO_DEVICE_INDEX=0
OUTPUT_AUDIO_DEVICE=default
PLAYBACK_MODE=file-only
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.80
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.0
