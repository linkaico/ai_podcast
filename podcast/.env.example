ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
XAI_API_KEY=

# Defaults to a local offline provider so the foundation can run without paid APIs.
ACTIVE_LLM=dry-run
ACTIVE_MODEL=dry-run-v1
# When ACTIVE_LLM is a live provider, set ACTIVE_MODEL to a real model id, e.g.:
#   anthropic -> claude-opus-4-8   (or claude-sonnet-4-6 for lower cost)
#   openai    -> gpt-4o            (or a current OpenAI model)
#   google    -> gemini-2.0-flash  (or a current Gemini model)
CONVERSATION_MODE=dry-run

# Audio pipeline modes
INPUT_MODE=text
STT_MODE=deepgram
TTS_MODE=dry-run
DEEPGRAM_MODEL=nova-3
ELEVENLABS_MODEL=eleven_flash_v2_5
XAI_STT_LANGUAGE=en
XAI_TTS_VOICE=eve
XAI_TTS_LANGUAGE=en
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MAX_RECORD_SECONDS=600
CONFIRM_TRANSCRIPT=true
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=1
PROVIDER_MAX_OUTPUT_TOKENS=2048
OPENAI_API_MODE=responses

ELEVENLABS_VOICE_ID=
AUDIO_DEVICE_INDEX=default
OUTPUT_AUDIO_DEVICE=default
PLAYBACK_MODE=file-only
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.80
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.0

# Primary live path: OpenAI Realtime native speech-to-speech.
# Set CONVERSATION_MODE=realtime, INPUT_MODE=mic, and OPENAI_API_KEY above.
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_VAD_MODE=semantic_vad
REALTIME_SAMPLE_RATE=24000
