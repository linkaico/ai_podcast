.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

sessions/*.json
sessions/*.tmp
sessions/*.lock
exports/*
config/prompts/episodes/*.txt
!exports/.gitkeep
!config/prompts/episodes/.gitkeep

# Audio: ignore all recordings incl. session-scoped audio/<id>/..., keep placeholder dirs
audio/*
!audio/input
!audio/output
audio/input/*
audio/output/*
!audio/input/.gitkeep
!audio/output/.gitkeep
